# 우리(게임 친구) 서버가 결제를 받는 Solana Devnet 지갑 주소 (Phantom Devnet)
SOLANA_WALLET_ADDRESS=

# Google AI Studio에서 발급받은 Gemini API 키
GEMINI_API_KEY=

# AI 친구(정책 판단 엔진)의 /evaluate 서버 주소. 끝에 /evaluate 붙이지 않고 base URL만.
# 예: http://localhost:8000
POLICY_ENGINE_URL=http://localhost:8000

# 메인 서버와 정책 서버 사이의 인증용 공통 비밀값 (두 서비스에 같은 값을 설정)
POLICY_SHARED_SECRET=

# Solana Devnet RPC 엔드포인트 (온체인 USDC 잔액 조회용)
SOLANA_RPC_URL=https://api.devnet.solana.com

# x402 결제 검증/정산을 대행하는 facilitator (테스트용 공식 서비스, Solana Devnet 지원)
FACILITATOR_URL=https://x402.org/facilitator

# Gemini 1회 호출당 청구할 금액 (USD, project.md 3단계에서 402 응답에 실리는 가격)
GEMINI_PRICE_USD=0.005

# 공개 데모 및 브라우저 접근 설정
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5500

# Agent Wallet(자율 결제) 개인키. base58 문자열(Phantom "개인 키 내보내기"와 같은 형식).
# Render 같은 클라우드 배포는 재배포·재시작마다 파일시스템이 초기화돼서, 이 값이
# 없으면 매번 새 지갑이 생성되고 충전해둔 자금을 잃어버린다. 배포 환경에서는
# 반드시 설정할 것 (로컬 개발은 비워두면 agent_wallet.json 파일로 자동 대체됨).
AGENT_WALLET_PRIVATE_KEY=
